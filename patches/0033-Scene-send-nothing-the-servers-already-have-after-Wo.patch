+// After a shift of the world the physics server has moved it already: what was sent before, moved
+// by the shift since, is sent again only if the node has moved on its own as well.
+void CollisionObject3D::_set_server_transform(const Transform3D &p_transform) {
+	const Ref<World3D> world = is_inside_tree() ? get_world_3d() : Ref<World3D>();
+	const Vector3 shift = world.is_valid() ? world->get_physics_shift() : Vector3();
+	if (transform_sent && shift != sent_shift) {
+		sent_transform.origin += shift - sent_shift;
+		sent_shift = shift;
+		// Recomputed after a shift, a transform differs from the shifted one in its last bits.
+		if (sent_transform.basis == p_transform.basis && sent_transform.origin.distance_squared_to(p_transform.origin) < 1e-6) {
+			return;
+		}
+	}
+	sent_shift = shift;
+	sent_transform = p_transform;
+	transform_sent = true;
+	if (area) {
+		PhysicsServer3D::get_singleton()->area_set_transform(rid, p_transform);
+	} else {
+		PhysicsServer3D::get_singleton()->body_set_state(rid, PS3DE::BODY_STATE_TRANSFORM, p_transform);
+	}
+}
+
+void CollisionObject3D::update_server_transform() {
+	if (is_inside_tree()) {
+		transform_sent = false;
+		_set_server_transform(get_global_transform());
+		_on_transform_changed(true); // Its debug shapes were moved on the renderer too.
+	}
+}
