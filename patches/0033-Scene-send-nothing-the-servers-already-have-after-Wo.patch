+// A floating origin's shift: everything in the world moves by p_by on the servers, at once (far
+// cheaper than node by node). The nodes are moved to match by moving what they hang from, and
+// VisualInstance3D and CollisionObject3D then see that the servers already have their new
+// transforms. Physics engines that can't shift a space (Godot Physics) leave its objects to be
+// moved one by one, as before.
+void World3D::shift(const Vector3 &p_by) {
+	if (p_by == Vector3()) {
+		return;
+	}
+	RS::get_singleton()->scenario_shift(scenario, p_by);
+	rendering_shift += p_by;
+#ifndef PHYSICS_3D_DISABLED
+	if (space.is_valid() && PhysicsServer3D::get_singleton()->space_shift(space, p_by)) {
+		physics_shift += p_by;
+	}
+#endif // PHYSICS_3D_DISABLED
+}
