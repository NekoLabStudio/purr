+// After a shift of the world the renderer has moved the instance already: what was sent before,
+// moved by the shift since, is sent again only if the node has moved on its own as well.
+void VisualInstance3D::_set_server_transform(const Transform3D &p_transform) {
+	const Ref<World3D> world = is_inside_tree() ? get_world_3d() : Ref<World3D>();
+	const Vector3 shift = world.is_valid() ? world->get_rendering_shift() : Vector3();
+	if (transform_sent && shift != sent_shift) {
+		sent_transform.origin += shift - sent_shift;
+		sent_shift = shift;
+		// Recomputed after a shift, a transform differs from the shifted one in its last bits.
+		if (sent_transform.basis == p_transform.basis && sent_transform.origin.distance_squared_to(p_transform.origin) < 1e-6) {
+			return;
+		}
+	}
+	sent_shift = shift;
+	sent_transform = p_transform;
+	transform_sent = true;
+	RS::get_singleton()->instance_set_transform(instance, p_transform);
+}
