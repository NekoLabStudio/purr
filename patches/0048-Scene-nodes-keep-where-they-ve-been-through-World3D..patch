diff --git a/godot/scene/3d/physics/joints/joint_3d.cpp b/godot/scene/3d/physics/joints/joint_3d.cpp
index 0f09afa1..6218d246 100644
--- a/godot/scene/3d/physics/joints/joint_3d.cpp
+++ b/godot/scene/3d/physics/joints/joint_3d.cpp
@@ -203,6 +203,19 @@ bool Joint3D::get_exclude_nodes_from_collision() const {
 	return exclude_from_collision;
 }
 
+// A joint with one body holds it to a place in the world, kept in global space by the physics server: made
+// again, it holds it where the joint now is, whether a shift of the server's whole space moved that place
+// and the joint was put back, or the joint moved with the world and the server couldn't shift.
+void Joint3D::update_server_transform() {
+	if (configured && (!ba.is_valid() || !bb.is_valid())) {
+		_update_joint();
+	}
+}
+
+void Joint3D::world_shifted(const Vector3 &p_by) {
+	update_server_transform();
+}
+
 PackedStringArray Joint3D::get_configuration_warnings() const {
 	PackedStringArray warnings = Node3D::get_configuration_warnings();
 
