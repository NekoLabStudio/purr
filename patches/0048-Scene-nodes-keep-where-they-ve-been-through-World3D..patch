 	void update_position(const Vector3 &p_position);
 	Vector3 get_tracked_linear_velocity() const;
+	void shift(const Vector3 &p_by); // Everything it tracked moved by p_by at once: its speed stays.
 
 	VelocityTracker3D();
 };
