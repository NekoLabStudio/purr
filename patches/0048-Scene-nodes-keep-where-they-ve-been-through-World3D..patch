diff --git a/godot/scene/3d/audio_listener_3d.cpp b/godot/scene/3d/audio_listener_3d.cpp
index ae109ab8..45633d7c 100644
--- a/godot/scene/3d/audio_listener_3d.cpp
+++ b/godot/scene/3d/audio_listener_3d.cpp
@@ -177,6 +177,15 @@ void AudioListener3D::_bind_methods() {
 	BIND_ENUM_CONSTANT(DOPPLER_TRACKING_PHYSICS_STEP);
 }
 
+// Its speed for the Doppler effect comes from where it was: those places moved with it. Where it is
+// now was noted as it moved, already shifted, so it's noted again.
+void AudioListener3D::world_shifted(const Vector3 &p_by) {
+	velocity_tracker->shift(p_by);
+	if (doppler_tracking != DOPPLER_TRACKING_DISABLED) {
+		velocity_tracker->update_position(get_global_transform().origin);
+	}
+}
+
 Vector3 AudioListener3D::get_doppler_tracked_velocity() const {
 	if (doppler_tracking != DOPPLER_TRACKING_DISABLED) {
 		return velocity_tracker->get_tracked_linear_velocity();
