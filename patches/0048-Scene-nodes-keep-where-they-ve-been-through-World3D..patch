diff --git a/godot/scene/3d/trail_3d.cpp b/godot/scene/3d/trail_3d.cpp
index 4329a326..34244730 100644
--- a/godot/scene/3d/trail_3d.cpp
+++ b/godot/scene/3d/trail_3d.cpp
@@ -414,6 +414,15 @@ real_t Trail3D::_calc_current_length() const {
 	return length;
 }
 
+// The trail's points are where it has been, in global space: they moved with it.
+void Trail3D::world_shifted(const Vector3 &p_by) {
+	Vector3 *w = points.ptrw();
+	for (int i = 0; i < points.size(); i++) {
+		w[i] += p_by;
+	}
+	_previous_position += p_by;
+}
+
 real_t Trail3D::get_current_length() const {
 	return _calc_current_length();
 }
diff --git a/godot/scene/3d/trail_3d.h b/godot/scene/3d/trail_3d.h
