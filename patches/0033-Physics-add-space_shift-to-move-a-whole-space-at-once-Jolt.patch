 #include "../jolt_physics_server_3d.h"
 #include "../jolt_project_settings.h"
 #include "../misc/jolt_stream_wrappers.h"
+#include "../misc/jolt_type_conversions.h"
 #include "../objects/jolt_area_3d.h"
 #include "../objects/jolt_body_3d.h"
 #include "../shapes/jolt_shape_3d.h"
@@ -599,3 +600,31 @@ void JoltSpace3D::set_max_debug_contacts(int p_count) {
 }
 
 #endif
+
+// A floating origin's shift: every body moves by p_by together, a teleport (no velocity, nothing
+// woken), so nothing moves relative to anything else. Constraints are held in their bodies' own
+// frames, and a soft body's vertices in its body's, so they come along.
+void JoltSpace3D::shift(const Vector3 &p_by) {
+	if (p_by == Vector3()) {
+		return;
+	}
+
+	JPH::BodyIDVector body_ids;
+	physics_system->GetBodies(body_ids);
+
+	JPH::BodyInterface &body_iface = get_body_iface();
+	const JPH::RVec3 by = to_jolt_r(p_by);
+
+	for (const JPH::BodyID &body_id : body_ids) {
+		body_iface.SetPosition(body_id, body_iface.GetPosition(body_id) + by, JPH::EActivation::DontActivate);
+
+		JoltObject3D *object = reinterpret_cast<JoltObject3D *>(body_iface.GetUserData(body_id));
+		if (object != nullptr) {
+			object->space_shifted(p_by);
+		}
+	}
+
+	// Every body moved, its broad phase's tree is rebuilt at once: left, the next step rebuilt it piecemeal, tens of
+	// milliseconds with thousands of bodies.
+	physics_system->OptimizeBroadPhase();
+}
