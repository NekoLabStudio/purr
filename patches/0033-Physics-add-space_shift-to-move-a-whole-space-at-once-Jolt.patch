--- a/godot/modules/jolt_physics/jolt_physics_server_3d.cpp
+++ b/godot/modules/jolt_physics/jolt_physics_server_3d.cpp
@@ -194,6 +194,14 @@ RID JoltPhysicsServer3D::space_create() {
 	return rid;
 }
 
+bool JoltPhysicsServer3D::space_shift(RID p_space, const Vector3 &p_by) {
+	JoltSpace3D *space = space_owner.get_or_null(p_space);
+	ERR_FAIL_NULL_V(space, false);
+
+	space->shift(p_by);
+	return true;
+}
+
 void JoltPhysicsServer3D::space_set_active(RID p_space, bool p_active) {
 	JoltSpace3D *space = space_owner.get_or_null(p_space);
 	ERR_FAIL_NULL(space);
