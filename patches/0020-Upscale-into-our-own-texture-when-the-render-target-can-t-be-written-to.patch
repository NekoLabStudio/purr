From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Sun, 15 Nov 2026 20:00:00 +0000
Subject: [PATCH] Upscale into our own texture when the render target can't be
 written to

FSR 1 and MetalFX's spatial upscaler write their result as a storage
image straight into the render target. In XR the render target is the
runtime's swapchain (OpenXR's), which is created without storage usage
(and is often sRGB, which can't be storage at all). On Vulkan and
Direct3D 12 the upscale fails, so XR games with FSR stop drawing; on
Metal, MetalFX aborts.

When the render target isn't a storage image, the upscalers now write
into a texture of the render buffers' own at the target size, which is
then drawn into the render target, as the bilinear path with SMAA
already does. MetalFX's scaler is created for that texture's format.

Test: an XR viewport with two views whose colour texture comes from an
XRInterfaceExtension without storage usage, with FSR or MetalFX
spatial scaling at 0.75: it renders without errors (before, MetalFX
aborted on Metal).

Upstream: to propose.
---
diff --git a/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp b/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
index 38540f4..f4e8c24 100644
--- a/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
+++ b/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
@@ -867,12 +867,19 @@ void RendererSceneRenderRD::_render_buffers_post_process_and_tonemap(const Rende
 		if (spatial_upscaler) {
 			spatial_upscaler->ensure_context(rb);
 
+			const bool own_texture = rb->upscales_into_own_texture();
+			const RID upscaled_texture = own_texture ? rb->get_upscale_texture() : RID();
+
 			for (uint32_t v = 0; v < rb->get_view_count(); v++) {
 				RID source_texture = rb->get_texture_slice(use_smaa ? SNAME("SMAA") : SNAME("Tonemapper"), SNAME("destination"), v, 0);
-				RID dest_texture = texture_storage->render_target_get_rd_texture_slice(render_target, v);
+				RID dest_texture = own_texture ? rb->get_texture_slice(SNAME("Upscaler"), SNAME("destination"), v, 0) : texture_storage->render_target_get_rd_texture_slice(render_target, v);
 
 				spatial_upscaler->process(rb, source_texture, dest_texture);
 			}
+
+			if (own_texture) {
+				copy_effects->copy_to_fb_rect(upscaled_texture, texture_storage->render_target_get_rd_framebuffer(render_target), Rect2i(Point2i(), rb->get_target_size()), false, false, false, false, RID(), rb->get_view_count() > 1);
+			}
 		} else {
 			// If no spatial upscaler is set, we are using bilinear or nearest filtering for scaling.
 			// This is only necessary if screen-space antialiasing is active, otherwise this happens automatically during tonemapping.
diff --git a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
index f395807..140ff30 100644
--- a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
+++ b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
@@ -265,10 +265,9 @@ void RenderSceneBuffersRD::ensure_mfx(RendererRD::MFXSpatialEffect *p_effect) {
 	RendererRD::TextureStorage *texture_storage = RendererRD::TextureStorage::get_singleton();
 	RenderingDevice *rd = RD::get_singleton();
 
-	// Determine the output format of the render target.
+	// The output is the render target, or our own texture when it can't be written to.
 	RID dest = texture_storage->render_target_get_rd_texture(render_target);
-	RD::TextureFormat tf = rd->texture_get_format(dest);
-	RD::DataFormat output_format = tf.format;
+	RD::DataFormat output_format = upscales_into_own_texture() ? get_base_data_format() : rd->texture_get_format(dest).format;
 
 	RendererRD::MFXSpatialEffect::CreateParams params = {
 		.input_size = internal_size,
@@ -289,6 +288,18 @@ bool RenderSceneBuffersRD::has_texture(const StringName &p_context, const String
 	return named_textures.has(key);
 }
 
+bool RenderSceneBuffersRD::upscales_into_own_texture() {
+	const RID target = RendererRD::TextureStorage::get_singleton()->render_target_get_rd_texture(render_target);
+	return !(RD::get_singleton()->texture_get_format(target).usage_bits & RD::TEXTURE_USAGE_STORAGE_BIT);
+}
+
+RID RenderSceneBuffersRD::get_upscale_texture() {
+	if (has_texture(SNAME("Upscaler"), SNAME("destination"))) {
+		return get_texture(SNAME("Upscaler"), SNAME("destination"));
+	}
+	return create_texture(SNAME("Upscaler"), SNAME("destination"), get_base_data_format(), RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_COLOR_ATTACHMENT_BIT, RD::TEXTURE_SAMPLES_1, target_size, 0, 1, true, true);
+}
+
 RID RenderSceneBuffersRD::create_texture(const StringName &p_context, const StringName &p_texture_name, const RD::DataFormat p_data_format, const uint32_t p_usage_bits, const RD::TextureSamples p_texture_samples, const Size2i p_size, const uint32_t p_layers, const uint32_t p_mipmaps, bool p_unique, bool p_discardable) {
 	// Keep some useful data, we use default values when these are 0.
 	Size2i size = p_size == Size2i(0, 0) ? internal_size : p_size;
diff --git a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h
index 77f306b..d8b0764 100644
--- a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h
+++ b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h
@@ -216,6 +216,12 @@ public:
 	// Named Textures
 
 	bool has_texture(const StringName &p_context, const StringName &p_texture_name) const;
+	// Spatial upscalers write their result as a storage image. When the render target can't be one
+	// (an XR runtime's swapchain, usually), they write into a texture of ours at the target size,
+	// which is then drawn into the render target.
+	bool upscales_into_own_texture();
+	RID get_upscale_texture();
+
 	RID create_texture(const StringName &p_context, const StringName &p_texture_name, const RD::DataFormat p_data_format, const uint32_t p_usage_bits, const RD::TextureSamples p_texture_samples = RD::TEXTURE_SAMPLES_1, const Size2i p_size = Size2i(0, 0), const uint32_t p_layers = 0, const uint32_t p_mipmaps = 1, bool p_unique = true, bool p_discardable = false);
 	RID create_texture_from_format(const StringName &p_context, const StringName &p_texture_name, const RD::TextureFormat &p_texture_format, RD::TextureView p_view = RD::TextureView(), bool p_unique = true);
 	RID create_texture_view(const StringName &p_context, const StringName &p_texture_name, const StringName &p_view_name, RD::TextureView p_view = RD::TextureView());
