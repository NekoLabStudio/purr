From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Sun, 15 Nov 2026 23:30:00 +0000
Subject: [PATCH] Upscalers: keep FSR 2 and MetalFX temporal contexts across
 scale changes

Changing scaling_3d_scale configures the render buffers again, which
freed the temporal upscalers' contexts. FSR 2 lost its history (a
moment of shimmer) and MetalFX's temporal scaler was built again, a
hitch of about 35 ms on an M4 Max each time. Dynamic resolution changes
the scale often, so neither is acceptable.

Both upscalers take a smaller input than they were created for: FSR 2
through its maximum and per-dispatch render sizes, MetalFX through its
input content size. The contexts are now created for input up to the
target's size, given each frame's size as it's drawn, and only made
again when the target size or formats change. They're freed with the
render buffer data.

Test: change scaling_3d_scale between 0.6 and 0.9 every few frames with
each upscaler: no frame after a change is slower than usual (MetalFX
temporal: was +35 ms), Metal API validation stays quiet, and a frame
after a change from 0.9 to 0.6 matches one drawn at 0.6 from the start.

Upstream: to propose.
---
--- a/godot/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.h
+++ b/godot/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.h
@@ -95,10 +95,19 @@
 
 	private:
 		RenderSceneBuffersRD *render_buffers = nullptr;
+		// The temporal upscalers' contexts outlive a change of scale (the render buffers being
+		// configured again): created for the largest input, they take each frame's size, so a
+		// change keeps their history and doesn't build a new context.
 		RendererRD::FSR2Context *fsr2_context = nullptr;
+		Size2i fsr2_max_render_size;
+		Size2i fsr2_target_size;
 #ifdef METAL_MFXTEMPORAL_ENABLED
 		RendererRD::MFXTemporalContext *mfx_temporal_context = nullptr;
+		Size2i mfx_temporal_target_size;
+		RD::DataFormat mfx_temporal_color_format = RD::DATA_FORMAT_MAX;
+		RD::DataFormat mfx_temporal_depth_format = RD::DATA_FORMAT_MAX;
 #endif
+		void _free_upscalers();
 
 	public:
 		ClusterBuilderRD *cluster_builder = nullptr;
@@ -159,6 +168,7 @@
 
 		virtual void configure(RenderSceneBuffersRD *p_render_buffers) override;
 		virtual void free_data() override;
+		~RenderBufferDataForwardClustered();
 
 		static RD::DataFormat get_specular_format();
 		static uint32_t get_specular_usage_bits(bool p_resolve, bool p_msaa, bool p_storage);
--- a/godot/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp
+++ b/godot/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp
@@ -91,23 +91,43 @@
 }
 
 void RenderForwardClustered::RenderBufferDataForwardClustered::ensure_fsr2(RendererRD::FSR2Effect *p_effect) {
+	Size2i internal_size = render_buffers->get_internal_size();
+	Size2i target_size = render_buffers->get_target_size();
+	if (fsr2_context != nullptr && (target_size != fsr2_target_size || internal_size.x > fsr2_max_render_size.x || internal_size.y > fsr2_max_render_size.y)) {
+		memdelete(fsr2_context);
+		fsr2_context = nullptr;
+	}
 	if (fsr2_context == nullptr) {
-		fsr2_context = p_effect->create_context(render_buffers->get_internal_size(), render_buffers->get_target_size());
+		// Created for up to the target's size, so any scale up to 1.0 fits without a new one.
+		fsr2_max_render_size = internal_size.max(target_size);
+		fsr2_target_size = target_size;
+		fsr2_context = p_effect->create_context(fsr2_max_render_size, target_size);
 	}
 }
 
 #ifdef METAL_MFXTEMPORAL_ENABLED
 bool RenderForwardClustered::RenderBufferDataForwardClustered::ensure_mfx_temporal(RendererRD::MFXTemporalEffect *p_effect) {
+	Size2i target_size = render_buffers->get_target_size();
+	RD::DataFormat color_format = render_buffers->get_base_data_format();
+	RD::DataFormat depth_format = render_buffers->get_depth_format(false, false, render_buffers->get_can_be_storage());
+	if (mfx_temporal_context != nullptr && (target_size != mfx_temporal_target_size || color_format != mfx_temporal_color_format || depth_format != mfx_temporal_depth_format)) {
+		memdelete(mfx_temporal_context);
+		mfx_temporal_context = nullptr;
+	}
 	if (mfx_temporal_context == nullptr) {
+		// Created for input up to the target's size, with each frame's size given as it's drawn
+		// (MetalFX's input content size), so a change of scale doesn't build a new scaler.
+		mfx_temporal_target_size = target_size;
+		mfx_temporal_color_format = color_format;
+		mfx_temporal_depth_format = depth_format;
 		RendererRD::MFXTemporalEffect::CreateParams params;
-		params.input_size = render_buffers->get_internal_size();
-		params.output_size = render_buffers->get_target_size();
-		params.input_format = render_buffers->get_base_data_format();
-		params.depth_format = render_buffers->get_depth_format(false, false, render_buffers->get_can_be_storage());
+		params.input_size = target_size;
+		params.output_size = target_size;
+		params.input_format = color_format;
+		params.depth_format = depth_format;
 		params.motion_format = render_buffers->get_velocity_format();
 		params.reactive_format = render_buffers->get_base_data_format(); // Reactive is derived from input.
 		params.output_format = render_buffers->get_base_data_format();
-		params.motion_vector_scale = render_buffers->get_internal_size();
 		mfx_temporal_context = p_effect->create_context(params);
 		return true;
 	}
@@ -115,6 +135,24 @@
 }
 #endif
 
+void RenderForwardClustered::RenderBufferDataForwardClustered::_free_upscalers() {
+	if (fsr2_context) {
+		memdelete(fsr2_context);
+		fsr2_context = nullptr;
+	}
+
+#ifdef METAL_MFXTEMPORAL_ENABLED
+	if (mfx_temporal_context) {
+		memdelete(mfx_temporal_context);
+		mfx_temporal_context = nullptr;
+	}
+#endif
+}
+
+RenderForwardClustered::RenderBufferDataForwardClustered::~RenderBufferDataForwardClustered() {
+	_free_upscalers();
+}
+
 void RenderForwardClustered::RenderBufferDataForwardClustered::free_data() {
 	// JIC, should already have been cleared
 	if (render_buffers) {
@@ -131,17 +169,7 @@
 		cluster_builder = nullptr;
 	}
 
-	if (fsr2_context) {
-		memdelete(fsr2_context);
-		fsr2_context = nullptr;
-	}
-
-#ifdef METAL_MFXTEMPORAL_ENABLED
-	if (mfx_temporal_context) {
-		memdelete(mfx_temporal_context);
-		mfx_temporal_context = nullptr;
-	}
-#endif
+	// The upscalers' contexts stay for the next configuration (ensure_fsr2, ensure_mfx_temporal).
 
 	if (!render_sdfgi_uniform_set.is_null() && RD::get_singleton()->uniform_set_is_valid(render_sdfgi_uniform_set)) {
 		RD::get_singleton()->free_rid(render_sdfgi_uniform_set);
@@ -2631,6 +2659,7 @@
 				params.exposure = exposure;
 				params.dst = rb->get_upscaled_texture(v);
 				params.jitter_offset = jitter;
+				params.input_size = rb->get_internal_size();
 				params.reset = reset;
 
 				mfx_temporal_effect->process(rb_data->get_mfx_temporal_context(), params);
--- a/godot/servers/rendering/renderer_rd/effects/metal_fx.h
