 		RDD::DataFormat output_format;
-		Vector2 motion_vector_scale;
 	};
 
 	MFXTemporalContext *create_context(CreateParams p_params) const;
@@ -165,6 +167,7 @@
 		RID exposure;
 		RID dst;
 		Vector2 jitter_offset;
+		Vector2i input_size; // This frame's, up to the context's input size.
 		bool reset = false;
 	};
 
--- a/godot/servers/rendering/renderer_rd/effects/metal_fx.cpp
+++ b/godot/servers/rendering/renderer_rd/effects/metal_fx.cpp
@@ -148,13 +148,16 @@
 	desc->setDepthTextureFormat((MTL::PixelFormat)pf.getMTLPixelFormat(p_params.depth_format));
 	desc->setMotionTextureFormat((MTL::PixelFormat)pf.getMTLPixelFormat(p_params.motion_format));
