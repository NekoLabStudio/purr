 	scaler->setOutputTexture(dst_texture);
 	MTLFX::TemporalScaler *s = static_cast<MTLFX::TemporalScaler *>(scaler);
 	MTL3::MDCommandBuffer *cmd = (MTL3::MDCommandBuffer *)(p_command_buffer.id);
