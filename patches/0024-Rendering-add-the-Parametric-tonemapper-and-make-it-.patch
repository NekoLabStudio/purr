diff --git a/godot/doc/classes/Environment.xml b/godot/doc/classes/Environment.xml
index ca9d1407..5faae11a 100644
--- a/godot/doc/classes/Environment.xml
+++ b/godot/doc/classes/Environment.xml
@@ -323,15 +323,27 @@
 			The white reference value for tonemapping, which indicates where bright white is located in the scale of values provided to the tonemapper. For photorealistic lighting, it is recommended to set [member tonemap_agx_white] to at least [code]6.0[/code]. Higher values result in less blown out highlights, but may make the scene appear lower contrast. [member tonemap_agx_white] is the same as [member tonemap_white], but is only effective with the [constant TONE_MAPPER_AGX] tonemapper. See also [member tonemap_exposure].
 			[b]Note:[/b] When using the Mobile renderer with [member Viewport.use_hdr_2d] disabled, [member tonemap_agx_white] is ignored and a white value of [code]2.0[/code] will always be used instead. Otherwise, [member tonemap_agx_white] will be dynamically adjusted at runtime by multiplying it by the parent window's [method Window.get_output_max_linear_value] when using [member Viewport.use_hdr_2d] to ensure good behavior with both SDR and HDR output.
 		</member>
+		<member name="tonemap_parametric_shoulder" type="float" setter="set_tonemap_parametric_shoulder" getter="get_tonemap_parametric_shoulder" default="0.4">
+			How early bright values start to roll off into white, as a share of the way from mid gray to white. Higher values start the roll-off sooner, keeping more detail in bright areas at the cost of contrast. Only effective with the [constant TONE_MAPPER_PARAMETRIC] tonemapper.
+		</member>
+		<member name="tonemap_parametric_slope" type="float" setter="set_tonemap_parametric_slope" getter="get_tonemap_parametric_slope" default="0.74">
+			The contrast of the middle of the curve, around mid gray. Higher values make the image punchier, lower values flatter. Only effective with the [constant TONE_MAPPER_PARAMETRIC] tonemapper.
+		</member>
+		<member name="tonemap_parametric_toe" type="float" setter="set_tonemap_parametric_toe" getter="get_tonemap_parametric_toe" default="0.95">
+			How far up from black the soft shadow part of the curve reaches, as a share of mid gray. Higher values give softer, more lifted-looking shadow transitions, lower values keep shadows linear down to near black. Only effective with the [constant TONE_MAPPER_PARAMETRIC] tonemapper.
+		</member>
+		<member name="tonemap_parametric_white_clip" type="float" setter="set_tonemap_parametric_white_clip" getter="get_tonemap_parametric_white_clip" default="0.02">
+			How far past white the highlight roll-off aims. A small value lets the brightest parts of the scene reach full white; [code]0.0[/code] approaches white without ever reaching it. Only effective with the [constant TONE_MAPPER_PARAMETRIC] tonemapper.
+		</member>
 		<member name="tonemap_exposure" type="float" setter="set_tonemap_exposure" getter="get_tonemap_exposure" default="1.0">
 			Adjusts the brightness of values before they are provided to the tonemapper. Higher [member tonemap_exposure] values result in a brighter image. See also [member tonemap_white].
 			[b]Note:[/b] Values provided to the tonemapper will also be multiplied by [code]2.0[/code] and [code]1.8[/code] for [constant TONE_MAPPER_FILMIC] and [constant TONE_MAPPER_ACES] respectively to produce a similar apparent brightness as [constant TONE_MAPPER_LINEAR].
 		</member>
-		<member name="tonemap_mode" type="int" setter="set_tonemapper" getter="get_tonemapper" enum="Environment.ToneMapper" default="0">
+		<member name="tonemap_mode" type="int" setter="set_tonemapper" getter="get_tonemapper" enum="Environment.ToneMapper" default="5">
 			The tonemapping mode to use. Tonemapping is the process that "converts" HDR values to be suitable for rendering on an LDR display. (Godot doesn't support rendering on HDR displays yet.)
 		</member>
 		<member name="tonemap_white" type="float" setter="set_tonemap_white" getter="get_tonemap_white" default="1.0">
-			The white reference value for tonemapping, which indicates where bright white is located in the scale of values provided to the tonemapper. For photorealistic lighting, it is recommended to set [member tonemap_white] to at least [code]6.0[/code]. Higher values result in less blown out highlights, but may make the scene appear lower contrast. [member tonemap_agx_white] will be used instead when using the [constant TONE_MAPPER_AGX] tonemapper. See also [member tonemap_exposure].
+			The white reference value for tonemapping, which indicates where bright white is located in the scale of values provided to the tonemapper. For photorealistic lighting, it is recommended to set [member tonemap_white] to at least [code]6.0[/code]. Higher values result in less blown out highlights, but may make the scene appear lower contrast. [member tonemap_agx_white] will be used instead when using the [constant TONE_MAPPER_AGX] tonemapper. [member tonemap_white] is not used by the [constant TONE_MAPPER_PARAMETRIC] tonemapper, which always reaches white on its own. See also [member tonemap_exposure].
 			[b]Note:[/b] [member tonemap_white] must be set to [code]2.0[/code] or lower on the Mobile renderer to produce bright images.
 			[b]Note:[/b] [member tonemap_white] is ignored when using [constant TONE_MAPPER_LINEAR] and will be dynamically adjusted at runtime to never be less than the parent window's [method Window.get_output_max_linear_value] when using [constant TONE_MAPPER_REINHARDT] with [member Viewport.use_hdr_2d].
 		</member>
@@ -444,6 +456,10 @@
 		<constant name="TONE_MAPPER_AGX" value="4" enum="ToneMapper">
 			Uses an adjustable film-like tonemapping curve and desaturates bright values for a more realistic appearance. Better than other tonemappers at maintaining the hue of colors as they become brighter. The slowest tonemapping option.
 		</constant>
+		<constant name="TONE_MAPPER_PARAMETRIC" value="5" enum="ToneMapper">
+			Uses a film-like tonemapping curve in a wide color space, with gentle desaturation of bright values. Mid gray stays where it is, shadows fall off softly and highlights roll off smoothly into white. Its curve can be adjusted with [member tonemap_parametric_slope], [member tonemap_parametric_toe], [member tonemap_parametric_shoulder] and [member tonemap_parametric_white_clip]. This is the default tonemapper.
+			[b]Note:[/b] This tonemapper does not support HDR output because it produces output in the SDR range. It is recommended to use a different tonemapper when rendering to an HDR screen.
+		</constant>
 		<constant name="GLOW_BLEND_MODE_ADDITIVE" value="0" enum="GlowBlendMode">
 			Adds the glow effect to the scene.
 		</constant>
