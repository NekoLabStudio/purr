From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Sun, 15 Nov 2026 17:30:00 +0000
Subject: [PATCH] Download export templates from Purr's releases

Export Template Manager's Download and Install asked godotengine.org's
mirror list for this version's templates. Purr's version string isn't
one godotengine.org knows, and Godot's templates wouldn't work with
Purr's editor anyway. Its check for builds without downloadable
templates ("dev", "beta", "rc") doesn't match numbered statuses such
as "beta3" either, so it always asked.

The one mirror is now the .tpz attached to the Purr release of this
editor's version on GitHub
(https://github.com/NekoLabStudio/purr/releases/download/v<version>/purr-<version>-templates.tpz),
which the Release workflow uploads. Offline mode and double-precision
builds still offer no download.

Test: in a released Purr editor, Editor > Manage Export Templates
lists "Purr releases on GitHub", and Download and Install installs the
templates for that version.

Upstream: Purr only (Godot's own mirror list is right for Godot).
---
 .../editor/export/export_template_manager.cpp | 35 ++++++++++---------
 1 file changed, 18 insertions(+), 17 deletions(-)

diff --git a/godot/editor/export/export_template_manager.cpp b/godot/editor/export/export_template_manager.cpp
index 0243f089..58b6d980 100644
--- a/godot/editor/export/export_template_manager.cpp
+++ b/godot/editor/export/export_template_manager.cpp
@@ -69,28 +69,29 @@ void ExportTemplateManager::_request_mirrors() {
 	mirrors_empty = true;
 	_update_install_button();
 
-	// Downloadable export templates are only available for stable and official alpha/beta/RC builds
-	// (which always have a number following their status, e.g. "alpha1").
-	// Therefore, don't display download-related features when using a development version
-	// (whose builds aren't numbered).
-	if (!strcmp(GODOT_VERSION_STATUS, "dev") || !strcmp(GODOT_VERSION_STATUS, "beta") || !strcmp(GODOT_VERSION_STATUS, "rc")) {
-		_set_empty_mirror_list();
-		mirrors_list->set_tooltip_text(TTRC("Official export templates aren't available for development builds."));
+	// Purr's export templates come with each Purr release on GitHub, as one .tpz named after
+	// Purr's version, so there's no list of mirrors to fetch.
 #ifdef REAL_T_IS_DOUBLE
-	} else if (true) {
+	_set_empty_mirror_list();
+	mirrors_list->set_tooltip_text(TTRC("Official export templates aren't available for double-precision builds."));
+#else
+	if (!_is_online()) {
 		_set_empty_mirror_list();
-		mirrors_list->set_tooltip_text(TTRC("Official export templates aren't available for double-precision builds."));
-#endif
-	} else if (!_is_online()) {
 		mirrors_list->set_tooltip_text(TTRC("Template downloading is disabled in offline mode."));
-	} else {
-		mirrors_list->set_tooltip_text(String());
+		return;
 	}
-
-	if (mirrors_list->get_tooltip_text().is_empty()) {
-		const String mirrors_metadata_url = vformat("https://godotengine.org/mirrorlist/%s.json", GODOT_VERSION_FULL_CONFIG);
-		mirrors_requester->request(mirrors_metadata_url);
+	mirrors_list->set_tooltip_text(String());
+	mirrors_list->add_item(TTRC("Purr releases on GitHub"));
+	mirrors_list->set_item_metadata(-1, vformat("https://github.com/NekoLabStudio/purr/releases/download/v%s/purr-%s-templates.tpz", GODOT_VERSION_BUILD, GODOT_VERSION_BUILD));
+	mirrors_list->set_disabled(false);
+	open_mirror->set_disabled(false);
+	mirrors_empty = false;
+	_update_install_button();
+	if (!is_downloading()) {
+		// Some tree buttons won't show until there's a mirror.
+		_update_template_tree();
 	}
+#endif
 }
 
 void ExportTemplateManager::_mirrors_request_completed(int p_result, int p_response_code, const PackedStringArray &p_headers, const PackedByteArray &p_body) {
