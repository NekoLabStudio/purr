From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Sun, 15 Nov 2026 20:15:00 +0000
Subject: [PATCH] XR: draw upscaled frames with our own depth, then copy it to
 the runtime's

When an XR runtime takes depth (OpenXR's xr/openxr/submit_depth_buffer),
the renderer drew straight into the runtime's depth texture, which is
at the target size. With any 3D scaling the colour is drawn at the
internal size, so the framebuffer mixed sizes ("All textures in a
framebuffer should be the same size") and nothing was drawn; MetalFX
aborted.

The runtime's depth is now used directly only at the target size
(RenderSceneBuffersRD::get_override_depth). Otherwise the renderer
draws into its own depth and, after post-processing, draws it into the
runtime's depth texture at full size with a small depth-writing shader
(copy_depth_to_fb.glsl), so the compositor still gets the frame's
depth.

Test: an XR viewport with two views whose colour and depth textures
come from an XRInterfaceExtension, with FSR, FSR 2, MetalFX spatial or
temporal scaling at 0.75: it renders without errors, and the
runtime's depth after a frame matches an unscaled frame's.

Upstream: to propose.
---
diff --git a/godot/servers/rendering/renderer_rd/effects/copy_effects.cpp b/godot/servers/rendering/renderer_rd/effects/copy_effects.cpp
index 8882b12..171bf8d 100644
--- a/godot/servers/rendering/renderer_rd/effects/copy_effects.cpp
+++ b/godot/servers/rendering/renderer_rd/effects/copy_effects.cpp
@@ -158,6 +158,23 @@ CopyEffects::CopyEffects(BitField<RasterEffects> p_raster_effects) {
 		cube_to_dp.pipeline.setup(shader, RD::RENDER_PRIMITIVE_TRIANGLES, RD::PipelineRasterizationState(), RD::PipelineMultisampleState(), dss, RD::PipelineColorBlendState(), 0);
 	}
 
+	{
+		copy_depth_to_fb.shader.initialize({ "\n", "\n#define USE_MULTIVIEW\n" });
+		if (!RendererCompositorRD::get_singleton()->is_xr_enabled()) {
+			copy_depth_to_fb.shader.set_variant_enabled(1, false);
+		}
+		copy_depth_to_fb.shader_version = copy_depth_to_fb.shader.version_create();
+		RD::PipelineDepthStencilState dss;
+		dss.enable_depth_test = true;
+		dss.depth_compare_operator = RD::COMPARE_OP_ALWAYS;
+		dss.enable_depth_write = true;
+		for (int i = 0; i < 2; i++) {
+			if (copy_depth_to_fb.shader.is_variant_enabled(i)) {
+				copy_depth_to_fb.pipelines[i].setup(copy_depth_to_fb.shader.version_get_shader(copy_depth_to_fb.shader_version, i), RD::RENDER_PRIMITIVE_TRIANGLES, RD::PipelineRasterizationState(), RD::PipelineMultisampleState(), dss, RD::PipelineColorBlendState(), 0);
+			}
+		}
+	}
+
 	{
 		// Initialize cubemap to octmap copier.
 		cube_to_octmap.shader.initialize({ "" });
@@ -392,6 +409,7 @@ CopyEffects::~CopyEffects() {
 
 	copy_to_fb.shader.version_free(copy_to_fb.shader_version);
 	cube_to_dp.shader.version_free(cube_to_dp.shader_version);
+	copy_depth_to_fb.shader.version_free(copy_depth_to_fb.shader_version);
 	cube_to_octmap.shader.version_free(cube_to_octmap.shader_version);
 
 	singleton = nullptr;
@@ -673,6 +691,28 @@ void CopyEffects::copy_to_fb_rect(RID p_source_rd_texture, RID p_dest_framebuffe
 	RD::get_singleton()->draw_list_end();
 }
 
+void CopyEffects::copy_depth_to_framebuffer(RID p_source_depth, RID p_dest_framebuffer, bool p_multiview) {
+	UniformSetCacheRD *uniform_set_cache = UniformSetCacheRD::get_singleton();
+	ERR_FAIL_NULL(uniform_set_cache);
+	MaterialStorage *material_storage = MaterialStorage::get_singleton();
+	ERR_FAIL_NULL(material_storage);
+
+	const int variant = p_multiview ? 1 : 0;
+	RID shader = copy_depth_to_fb.shader.version_get_shader(copy_depth_to_fb.shader_version, variant);
+	ERR_FAIL_COND(shader.is_null());
+
+	// Depth isn't blended between texels.
+	RID sampler = material_storage->sampler_rd_get_default(RSE::CANVAS_ITEM_TEXTURE_FILTER_NEAREST, RSE::CANVAS_ITEM_TEXTURE_REPEAT_DISABLED);
+	RD::Uniform u_source(RD::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE, 0, Vector<RID>({ sampler, p_source_depth }));
+
+	RD::DrawListID draw_list = RD::get_singleton()->draw_list_begin(p_dest_framebuffer, RD::DRAW_DEFAULT_ALL);
+	RD::get_singleton()->draw_list_bind_render_pipeline(draw_list, copy_depth_to_fb.pipelines[variant].get_render_pipeline(RD::INVALID_ID, RD::get_singleton()->framebuffer_get_format(p_dest_framebuffer)));
+	RD::get_singleton()->draw_list_bind_uniform_set(draw_list, uniform_set_cache->get_cache(shader, 0, u_source), 0);
+	RD::get_singleton()->draw_list_bind_index_array(draw_list, material_storage->get_quad_index_array());
+	RD::get_singleton()->draw_list_draw(draw_list, true);
+	RD::get_singleton()->draw_list_end();
+}
+
 void CopyEffects::copy_to_drawlist(RD::DrawListID p_draw_list, RD::FramebufferFormatID p_fb_format, RID p_source_rd_texture, bool p_linear, float p_linear_luminance_multiplier) {
 	UniformSetCacheRD *uniform_set_cache = UniformSetCacheRD::get_singleton();
 	ERR_FAIL_NULL(uniform_set_cache);
diff --git a/godot/servers/rendering/renderer_rd/effects/copy_effects.h b/godot/servers/rendering/renderer_rd/effects/copy_effects.h
