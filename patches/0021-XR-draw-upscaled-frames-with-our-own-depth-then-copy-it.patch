diff --git a/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp b/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
index f4e8c24..d42e78b 100644
--- a/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
+++ b/godot/servers/rendering/renderer_rd/renderer_scene_render_rd.cpp
@@ -906,6 +906,16 @@ void RendererSceneRenderRD::_render_buffers_post_process_and_tonemap(const Rende
 		RD::get_singleton()->draw_command_end_label();
 	}
 
+	// An XR runtime that takes depth (OpenXR's depth submission) gets ours, at its size: when
+	// upscaling, we drew into our own depth (see RenderSceneBuffersRD::get_override_depth).
+	RID xr_depth = texture_storage->render_target_get_override_depth(render_target);
+	if (rb.is_valid() && xr_depth.is_valid() && rb->get_internal_size() != rb->get_target_size()) {
+		RD::get_singleton()->draw_command_begin_label("Copy Depth To XR");
+		RID dest_fb = FramebufferCacheRD::get_singleton()->get_cache_multiview(rb->get_view_count(), xr_depth);
+		copy_effects->copy_depth_to_framebuffer(rb->get_texture(RB_SCOPE_BUFFERS, RB_TEX_DEPTH), dest_fb, rb->get_view_count() > 1);
+		RD::get_singleton()->draw_command_end_label();
+	}
+
 	texture_storage->render_target_disable_clear_request(render_target);
 }
 
diff --git a/godot/servers/rendering/renderer_rd/shaders/effects/copy_depth_to_fb.glsl b/godot/servers/rendering/renderer_rd/shaders/effects/copy_depth_to_fb.glsl
new file mode 100644
index 0000000..fcc73b8
--- /dev/null
+++ b/godot/servers/rendering/renderer_rd/shaders/effects/copy_depth_to_fb.glsl
@@ -0,0 +1,37 @@
+#[vertex]
+
+#version 450
+
+#VERSION_DEFINES
+
+layout(location = 0) out vec2 uv_interp;
+
+void main() {
+	vec2 base_arr[4] = vec2[](vec2(0.0, 0.0), vec2(0.0, 1.0), vec2(1.0, 1.0), vec2(1.0, 0.0));
+	uv_interp = base_arr[gl_VertexIndex];
+	gl_Position = vec4(uv_interp * 2.0 - 1.0, 0.0, 1.0);
+}
+
+#[fragment]
+
+#version 450
+
+#VERSION_DEFINES
+
+#ifdef USE_MULTIVIEW
+#extension GL_EXT_multiview : enable
+layout(set = 0, binding = 0) uniform sampler2DArray source_depth;
+#else
+layout(set = 0, binding = 0) uniform sampler2D source_depth;
+#endif
+
+layout(location = 0) in vec2 uv_interp;
+
+// Draws a depth texture into a depth attachment of another size, such as an XR runtime's.
+void main() {
+#ifdef USE_MULTIVIEW
+	gl_FragDepth = textureLod(source_depth, vec3(uv_interp, float(gl_ViewIndex)), 0.0).r;
+#else
+	gl_FragDepth = textureLod(source_depth, uv_interp, 0.0).r;
+#endif
+}
diff --git a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
