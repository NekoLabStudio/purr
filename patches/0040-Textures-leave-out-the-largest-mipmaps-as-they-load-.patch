From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Thu, 19 Nov 2026 13:14:47 +0000
Subject: [PATCH] Textures: leave out the largest mipmaps as they load, for
 less memory

rendering/textures/quality/skip_mipmaps (0 by default) leaves out that many
of the largest mipmaps of each texture that has mipmaps as it loads, down to
256 pixels across, so a graphics setting can take three quarters of texture
memory off at a time. The texture keeps its size; the editor always loads
textures whole.
---
 godot/doc/classes/ProjectSettings.xml        |  3 +++
 godot/scene/resources/compressed_texture.cpp | 15 +++++++++++++++
 godot/servers/rendering/rendering_server.cpp |  1 +
 3 files changed, 19 insertions(+)

diff --git a/godot/doc/classes/ProjectSettings.xml b/godot/doc/classes/ProjectSettings.xml
index d042f2f9..88266a1f 100644
--- a/godot/doc/classes/ProjectSettings.xml
+++ b/godot/doc/classes/ProjectSettings.xml
@@ -3571,6 +3571,9 @@
 		<member name="rendering/textures/streaming/min_lod" type="int" setter="" getter="" default="0">
 			The minimum LOD (mipmap level) that streamed textures start at when loaded. Higher values result in lower initial resolution and faster loading. Valid values are [code]0[/code] (full resolution) to [code]13[/code] (lowest resolution).
 		</member>
+		<member name="rendering/textures/quality/skip_mipmaps" type="int" setter="" getter="" default="0">
+			How many of the largest mipmaps of each texture with mipmaps (those used in 3D) are left out as it loads, for less video memory: each one left out takes three quarters of the texture's memory off and halves its sharpness. Textures aren't made smaller than 256 pixels across this way, and the editor always loads them whole. Read as textures load: a change applies to textures loaded after it.
+		</member>
 		<member name="rendering/textures/vram_compression/cache_gpu_compressor" type="bool" setter="" getter="" default="true">
 			If [code]true[/code], the GPU texture compressor will cache the local RenderingDevice and its resources (shaders and pipelines), making subsequent imports faster at the cost of increased memory usage.
 		</member>
diff --git a/godot/scene/resources/compressed_texture.cpp b/godot/scene/resources/compressed_texture.cpp
index 5db54a3f..d23f1fe4 100644
--- a/godot/scene/resources/compressed_texture.cpp
+++ b/godot/scene/resources/compressed_texture.cpp
@@ -30,6 +30,9 @@
 
 #include "compressed_texture.h"
 
+#include "core/config/engine.h"
+#include "core/config/project_settings.h"
+
 #include "core/io/file_access.h"
 #include "core/io/resource_loader.h"
 #include "core/object/class_db.h"
@@ -92,6 +95,18 @@ Error CompressedTexture2D::_load_data(const String &p_path, int &r_width, int &r
 		return ERR_CANT_OPEN;
 	}
 
+	// For less video memory, a game can leave out the largest levels of detail of the textures that
+	// have smaller ones (those used in 3D), down to 256 pixels across. The editor always has them all.
+	if (!Engine::get_singleton()->is_editor_hint() && image->has_mipmaps()) {
+		int skip = GLOBAL_GET_CACHED(int, "rendering/textures/quality/skip_mipmaps");
+		while (skip > 0 && image->get_mipmap_count() > 1 && MIN(image->get_width(), image->get_height()) / 2 >= 256) {
+			const int64_t offset = image->get_mipmap_offset(1);
+			const Vector<uint8_t> data = image->get_data();
+			image = Image::create_from_data(MAX(image->get_width() / 2, 1), MAX(image->get_height() / 2, 1), true, image->get_format(), data.slice(offset));
+			skip--;
+		}
+	}
+
 	return OK;
 }
 
diff --git a/godot/servers/rendering/rendering_server.cpp b/godot/servers/rendering/rendering_server.cpp
index 785f7d6f..b00d1301 100644
--- a/godot/servers/rendering/rendering_server.cpp
+++ b/godot/servers/rendering/rendering_server.cpp
@@ -3683,6 +3683,7 @@ void RenderingServer::init() {
 	GLOBAL_DEF("rendering/textures/vram_compression/cache_gpu_compressor", true);
 
 	GLOBAL_DEF("rendering/textures/lossless_compression/force_png", false);
+	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/quality/skip_mipmaps", PROPERTY_HINT_RANGE, "0,3,1"), 0);
 
 	GLOBAL_DEF(PropertyInfo(Variant::INT, "rendering/textures/webp_compression/compression_method", PROPERTY_HINT_RANGE, "0,6,1"), 2);
 	GLOBAL_DEF(PropertyInfo(Variant::FLOAT, "rendering/textures/webp_compression/lossless_compression_factor", PROPERTY_HINT_RANGE, "0,100,1"), 25);
-- 
