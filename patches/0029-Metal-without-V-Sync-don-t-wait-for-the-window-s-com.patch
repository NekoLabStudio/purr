From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Mon, 16 Nov 2026 14:00:00 +0000
Subject: [PATCH] Metal: without V-Sync, don't wait for the window's compositor

On macOS a window's drawables come back at the compositor's pace, the
display's refresh rate, even with display sync off: so a windowed game
with V-Sync disabled still blocked in nextDrawable and ran at 60 fps on
a 60 Hz display (fullscreen, which bypasses the compositor, ran at
hundreds). An XR game was held to the window's rate this way, below
its headset's 72 to 120 Hz, which a headset shows as judder.

Without V-Sync, a frame now skips the window while a drawable it
presented is still waiting to reach the screen (counted with presented
handlers). The game renders at its own pace, and the window shows the
newest frame the compositor takes. V-Sync modes are unchanged.

Test: a windowed project with V-Sync disabled on a 60 Hz display reports
well above 60 fps; with OpenXR through a runtime pacing at 72 Hz, the
game renders at 72.

Upstream: to propose.
---
 .../drivers/metal/rendering_context_driver_metal.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/godot/drivers/metal/rendering_context_driver_metal.cpp b/godot/drivers/metal/rendering_context_driver_metal.cpp
index f4b649ae..5f58ad64 100644
--- a/godot/drivers/metal/rendering_context_driver_metal.cpp
+++ b/godot/drivers/metal/rendering_context_driver_metal.cpp
@@ -40,6 +40,9 @@
 
 #include <objc/message.h>
 #include <os/log.h>
+
+#include <atomic>
+#include <memory>
 #include <os/signpost.h>
 
 #if defined(VISIONOS_ENABLED) && defined(MODULE_VISIONOS_XR_ENABLED)
@@ -152,6 +155,10 @@ class API_AVAILABLE(macos(11.0), ios(14.0), tvos(14.0)) SurfaceLayer final : pub
 	uint32_t rear = -1;
 	uint32_t front = 0;
 	uint32_t count = 0;
+	// Drawables handed to the compositor and not yet on screen. Without V-Sync a frame skips the
+	// window while one is still waiting, rather than blocking in nextDrawable until the compositor
+	// (which runs at the display's rate, even with display sync off) frees one.
+	std::shared_ptr<std::atomic<int>> waiting = std::make_shared<std::atomic<int>>(0);
 
 public:
 	SurfaceLayer(CA::MetalLayer *p_layer, MTL::Device *p_device) :
@@ -230,6 +237,9 @@ public:
 		if (count == frame_buffers.size()) {
 			return RDD::FramebufferID();
 		}
+		if (vsync_mode == DisplayServerEnums::VSYNC_DISABLED && waiting->load() > 0) {
+			return RDD::FramebufferID();
+		}
 
 		rear = (rear + 1) % frame_buffers.size();
 		count++;
@@ -257,6 +267,8 @@ public:
 			if (vsync_mode != DisplayServerEnums::VSYNC_DISABLED) {
 				p_cmd_buffer->get_command_buffer()->presentDrawableAfterMinimumDuration(drawable, present_minimum_duration);
 			} else {
+				waiting->fetch_add(1);
+				drawable->addPresentedHandler([waiting = waiting](MTL::Drawable *) { waiting->fetch_sub(1); });
 				p_cmd_buffer->get_command_buffer()->presentDrawable(drawable);
 			}
 		}
