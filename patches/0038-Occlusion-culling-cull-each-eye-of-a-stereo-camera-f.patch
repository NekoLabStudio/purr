 	virtual void buffer_update(RID p_buffer, const Transform3D &p_cam_transform, const Projection &p_cam_projection, bool p_cam_orthogonal) {}
+	// A stereo camera's second eye has a buffer of its own, drawn from where that eye is: culled from
+	// one place between the eyes, what one eye saw past an occluder's edge would pop in and out.
+	virtual void buffer_update_second_eye(RID p_buffer, const Transform3D &p_cam_transform, const Projection &p_cam_projection, bool p_cam_orthogonal) {}
+	virtual HZBuffer *buffer_get_second_eye_ptr(RID p_buffer) { return nullptr; }
 
 	virtual RID buffer_get_debug_texture(RID p_buffer) {
 		_print_warning();
