+		Transform3D occlusion_transforms[2];
+		const Projection *occlusion_projections[2] = { nullptr, nullptr };
 		uint64_t visibility_viewport_mask;
 	};
 
diff --git a/godot/servers/rendering/renderer_scene_occlusion_cull.h b/godot/servers/rendering/renderer_scene_occlusion_cull.h
