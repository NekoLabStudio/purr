--- /dev/null
+++ b/godot/platform/tvos/SCsub
@@ -0,0 +1,50 @@
+#!/usr/bin/env python
+from misc.utility.scons_hints import *
+
+from platform_tvos_builders import generate_bundle
+from SCons.Script import Glob
+
+from platform_methods import combine_libs_apple_embedded, setup_swift_builder
+
+Import("env")
+
+swift_files = Glob("*.swift")
+swift_file_names = list(map(lambda f: f.name, swift_files))
+
+mm_files = Glob("*.mm")
+mm_file_names = list(map(lambda f: f.name, mm_files))
+
+env_tvos = env.Clone()
+
+# Configure Swift builder
+additional_swift_file_names = ["../../drivers/apple_embedded/godot_swiftui_view_controller.swift"]
+apple_platform = env["APPLE_PLATFORM"]
+sdk_path = env["APPLE_SDK_PATH"]
+current_path = Dir(".").abspath
+bridging_header_filename = "bridging_header_tvos.h"
+# The Swift sources are compiled together into a single object that's linked into the library.
+swift_module = setup_swift_builder(
+    env_tvos,
+    apple_platform,
+    sdk_path,
+    current_path,
+    bridging_header_filename,
+    swift_file_names + additional_swift_file_names,
+)
+
+# Enable module support
+env_tvos.Append(CCFLAGS=["-fmodules", "-fcxx-modules"])
+
+tvos_lib = env_tvos.add_library("tvos", mm_file_names + list(swift_module))
+if "LIBS_EXTERNAL" in env_tvos:
+    env_tvos.Depends(tvos_lib, env_tvos["LIBS_EXTERNAL"])
+
+# Build the Swift->ObjC interop header before any ObjC++ source that #imports it.
+env_tvos.Depends(tvos_lib, env_tvos["SWIFT_OBJC_HEADER_TARGET"])
+
+combine_command = env_tvos.CommandNoCache(
+    "#bin/libgodot" + env_tvos["LIBSUFFIX"], [tvos_lib] + env_tvos["LIBS"], env.Run(combine_libs_apple_embedded)
+)
+
+if env["generate_bundle"]:
+    env.AlwaysBuild(env.CommandNoCache("generate_bundle", combine_command, env.Run(generate_bundle)))
