+// A floating origin's shift: everything in the scenario moves by p_by at once, so nothing moves
+// relative to anything else. Shadows, light pairs, captured reflections and GI stay as they are,
+// and the culling trees keep their shape: only positions are added to, far cheaper than updating
+// each instance as if it alone had moved (in a large world, tens of milliseconds).
+void RendererSceneCull::scenario_shift(RID p_scenario, const Vector3 &p_by) {
+	Scenario *scenario = scenario_owner.get_or_null(p_scenario);
+	ERR_FAIL_NULL(scenario);
+	if (p_by == Vector3()) {
+		return;
+	}
+
+	for (SelfList<Instance> *E = scenario->instances.first(); E; E = E->next()) {
+		Instance *instance = E->self();
+		instance->transform.origin += p_by;
+		if (instance->update_item.in_list()) {
+			continue; // Updated in full this frame, from its new transform.
+		}
+		instance->transformed_aabb.position += p_by;
+		instance->prev_transformed_aabb.position += p_by;
+		const Transform3D &xform = instance->transform;
+
+		switch (instance->base_type) {
+			case RSE::INSTANCE_LIGHT: {
+				InstanceLightData *light = static_cast<InstanceLightData *>(instance->base_data);
+				RSG::light_storage->light_instance_set_transform(light->instance, xform);
+				RSG::light_storage->light_instance_set_aabb(light->instance, xform.xform(instance->aabb));
+			} break;
+			case RSE::INSTANCE_REFLECTION_PROBE: {
+				InstanceReflectionProbeData *reflection_probe = static_cast<InstanceReflectionProbeData *>(instance->base_data);
+				RSG::light_storage->reflection_probe_instance_shift(reflection_probe->instance, p_by);
+			} break;
+			case RSE::INSTANCE_DECAL: {
+				InstanceDecalData *decal = static_cast<InstanceDecalData *>(instance->base_data);
+				RSG::texture_storage->decal_instance_set_transform(decal->instance, xform);
+			} break;
+			case RSE::INSTANCE_LIGHTMAP: {
+				InstanceLightmapData *lightmap = static_cast<InstanceLightmapData *>(instance->base_data);
+				RSG::light_storage->lightmap_instance_set_transform(lightmap->instance, xform);
+			} break;
+			case RSE::INSTANCE_VOXEL_GI: {
+				InstanceVoxelGIData *voxel_gi = static_cast<InstanceVoxelGIData *>(instance->base_data);
+				scene_render->voxel_gi_instance_set_transform_to_data(voxel_gi->probe_instance, xform);
+			} break;
+			case RSE::INSTANCE_PARTICLES: {
+				RSG::particles_storage->particles_set_emission_transform(instance->base, xform);
+			} break;
+			case RSE::INSTANCE_PARTICLES_COLLISION: {
+				InstanceParticlesCollisionData *collision = static_cast<InstanceParticlesCollisionData *>(instance->base_data);
+				RSG::particles_storage->particles_collision_instance_set_transform(collision->instance, xform);
+				if (RSG::particles_storage->particles_collision_is_heightfield(instance->base)) {
+					heightfield_particle_colliders_update_list.insert(instance);
+				}
+			} break;
+			case RSE::INSTANCE_FOG_VOLUME: {
+				InstanceFogVolumeData *volume = static_cast<InstanceFogVolumeData *>(instance->base_data);
+				scene_render->fog_volume_instance_set_transform(volume->instance, xform);
+			} break;
+			case RSE::INSTANCE_OCCLUDER: {
+				RendererSceneOcclusionCull::get_singleton()->scenario_set_instance(scenario->self, instance->self, instance->base, xform, instance->visible);
+			} break;
+			default:
+				break;
+		}
+
+		if ((1 << instance->base_type) & RSE::INSTANCE_GEOMETRY_MASK) {
+			InstanceGeometryData *geom = static_cast<InstanceGeometryData *>(instance->base_data);
+			if (geom->geometry_instance) {
+				geom->geometry_instance->set_transform(xform, instance->aabb, instance->transformed_aabb);
+				// It didn't move on screen, but its last frame's place did: never drawn smeared across the shift.
+				geom->geometry_instance->reset_motion_vectors();
+			}
+		}
+
+		if (instance->array_index >= 0) {
+			scenario->instance_aabbs[instance->array_index] = InstanceBounds(instance->transformed_aabb);
+		}
+	}
+
+	for (int i = 0; i < Scenario::INDEXER_MAX; i++) {
+		scenario->indexers[i].shift(p_by);
+	}
+}
