diff --git a/godot/core/math/dynamic_bvh.cpp b/godot/core/math/dynamic_bvh.cpp
index 10753146..f3af43d3 100644
--- a/godot/core/math/dynamic_bvh.cpp
+++ b/godot/core/math/dynamic_bvh.cpp
@@ -438,3 +438,21 @@ int DynamicBVH::get_max_depth() const {
 DynamicBVH::~DynamicBVH() {
 	clear();
 }
+
+void DynamicBVH::shift(const Vector3 &p_by) {
+	if (bvh_root == nullptr) {
+		return;
+	}
+	LocalVector<Node *> stack;
+	stack.push_back(bvh_root);
+	while (!stack.is_empty()) {
+		Node *node = stack[stack.size() - 1];
+		stack.resize(stack.size() - 1);
+		node->volume.min += p_by;
+		node->volume.max += p_by;
+		if (node->is_internal()) {
+			stack.push_back(node->children[0]);
+			stack.push_back(node->children[1]);
+		}
+	}
+}
