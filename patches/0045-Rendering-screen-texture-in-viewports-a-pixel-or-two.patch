From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Nunes <ivo@nunes.uk>
Date: Thu, 19 Nov 2026 19:22:31 +0000
Subject: [PATCH] Rendering: screen texture in viewports a pixel or two across

A material reading the screen (hint_screen_texture), such as water, in a
viewport a pixel or two across made its blur textures with no mipmap
levels, or with -1 of them: "Too many mipmaps requested for texture
format and dimensions (4294967295)", and nothing to sample. Small
viewports are common (terrain picking renders through one), and a
water material in the scene was enough to hit it. Each blur texture now
has at least its full size level, and the half size one at least a
pixel.
---
 .../renderer_rd/storage_rd/render_scene_buffers_rd.cpp      | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
index e7496271..85990c41 100644
--- a/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
+++ b/godot/servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.cpp
@@ -541,7 +541,9 @@ void RenderSceneBuffersRD::allocate_blur_textures() {
 		blur_size = target_size;
 	}
 
-	uint32_t mipmaps_required = Image::get_image_required_mipmaps(blur_size.x, blur_size.y, Image::FORMAT_RGBAH);
+	// At least the full size level, and the half size texture at least a pixel with one level of its own:
+	// a viewport a pixel or two across (a picking viewport, say) needs no more, and asking for none fails.
+	const uint32_t mipmaps_required = MAX(Image::get_image_required_mipmaps(blur_size.x, blur_size.y, Image::FORMAT_RGBAH), 1);
 
 	uint32_t usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
 	if (can_be_storage) {
@@ -551,7 +553,7 @@ void RenderSceneBuffersRD::allocate_blur_textures() {
 	}
 
 	create_texture(RB_SCOPE_BUFFERS, RB_TEX_BLUR_0, get_base_data_format(), usage_bits, RD::TEXTURE_SAMPLES_1, blur_size, view_count, mipmaps_required);
-	create_texture(RB_SCOPE_BUFFERS, RB_TEX_BLUR_1, get_base_data_format(), usage_bits, RD::TEXTURE_SAMPLES_1, Size2i(blur_size.x >> 1, blur_size.y >> 1), view_count, mipmaps_required - 1);
+	create_texture(RB_SCOPE_BUFFERS, RB_TEX_BLUR_1, get_base_data_format(), usage_bits, RD::TEXTURE_SAMPLES_1, Size2i(blur_size.x >> 1, blur_size.y >> 1).maxi(1), view_count, MAX(mipmaps_required, 2u) - 1);
 
 	// TODO redo this:
 	if (!can_be_storage) {
