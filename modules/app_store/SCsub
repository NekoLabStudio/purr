#!/usr/bin/env python

import os
import subprocess

Import("env")
Import("env_modules")

env_app_store = env_modules.Clone()

# StoreKit 2 is Swift-only: store_kit.swift is compiled on its own into one object, with a header
# for app_store.mm to call it through.
platform = env["platform"]
apple_platform = env.get("APPLE_PLATFORM", platform)
sdk_names = {
    "macos": "macosx",
    "ios": "iphoneos",
    "iossimulator": "iphonesimulator",
    "tvos": "appletvos",
    "tvossimulator": "appletvsimulator",
    "visionos": "xros",
    "visionossimulator": "xrsimulator",
}
# The same minimum systems as the rest of the engine.
targets = {
    "macos": "macos13.0" if env["arch"] == "arm64" else "macos11.0",
    "ios": "ios15.0",
    "iossimulator": "ios15.0-simulator",
    "tvos": "tvos26.0",
    "tvossimulator": "tvos26.0-simulator",
    "visionos": "xros26.0",
    "visionossimulator": "xros26.0-simulator",
}


def xcrun(*arguments):
    return subprocess.check_output(["xcrun", *arguments], text=True).strip()


sdk_path = env.get("APPLE_SDK_PATH") or env.get("MACOS_SDK_PATH") or xcrun("--sdk", sdk_names[apple_platform], "--show-sdk-path")
swiftc = env.get("SWIFT_COMPILER") or xcrun("--find", "swiftc")
here = Dir(".").abspath
header = os.path.join(here, "purr_app_store-Swift.gen.h")
swift_object = env_app_store.Command(
    ["store_kit.swift" + env["OBJSUFFIX"], header],
    "store_kit.swift",
    [[
        swiftc,
        "-parse-as-library",
        "-wmo",
        "-swift-version",
        "5",
        "-module-name",
        "purr_app_store",
        "-target",
        env["arch"] + "-apple-" + targets[apple_platform],
        "-sdk",
        sdk_path,
        "-O",
        "-emit-object",
        "-emit-objc-header-path",
        "${TARGETS[1]}",
        "-o",
        "${TARGETS[0]}",
        "$SOURCE",
    ]],
)
env.modules_sources += [swift_object[0]]

objects = []
env_app_store.add_source_files(objects, "*.mm")
env_app_store.add_source_files(objects, "*.cpp")
env_app_store.Depends(objects, header)
env.modules_sources += objects

# On iOS, tvOS and visionOS the exported Xcode project links StoreKit and Swift's libraries
# (Purr's export plugin adds StoreKit; Godot's project template has Swift in it).
if platform == "macos":
    toolchain = os.path.dirname(os.path.dirname(swiftc))
    env.Append(
        LINKFLAGS=[
            "-framework",
            "StoreKit",
            "-L" + os.path.join(sdk_path, "usr/lib/swift"),
            "-L" + os.path.join(toolchain, "lib/swift/macosx"),
            "-Wl,-rpath,/usr/lib/swift",
        ]
    )
