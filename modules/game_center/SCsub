#!/usr/bin/env python

Import("env")
Import("env_modules")

env_game_center = env_modules.Clone()
env_game_center.add_source_files(env.modules_sources, "*.mm")
env_game_center.add_source_files(env.modules_sources, "*.cpp")

# On iOS and tvOS the exported Xcode project links GameKit (Purr's export plugin adds it).
if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "GameKit"])
