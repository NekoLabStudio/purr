#!/usr/bin/env python

import json
import os
import sys

Import("env")
Import("env_modules")

here = Dir(".").srcnode().abspath
sys.path.insert(0, here)
import prompt_images  # noqa: E402

env_controls = env_modules.Clone()


def bytes_literal(data):
    return ",".join(str(byte) for byte in data)


def write_if_changed(path, text):
    if os.path.exists(path) and open(path, encoding="utf-8").read() == text:
        return
    with open(path, "w", encoding="utf-8", newline="\n") as file:
        file.write(text)


# The built-in prompt images (prompt_images.py), embedded: each standard SVG once, the table of
# which control shows which, and the pixel style's sheet with its tiles for each control.
def generate_prompt_images():
    files = {}
    standard = []
    for family, control, file in prompt_images.standard_files():
        index = files.setdefault(file, len(files))
        standard.append((f"{family}/{control}", index))
    lines = ["// Generated by modules/controls/SCsub from prompt_images.py: don't edit.", "#pragma once", ""]
    for file, index in files.items():
        data = open(os.path.join(prompt_images.THIRDPARTY, "standard", file), "rb").read()
        lines.append(f"static const unsigned char PROMPT_SVG_{index}[] = {{{bytes_literal(data)}}};")
    lines += ["", "struct PromptSvg {", "\tconst char *control;", "\tconst unsigned char *data;", "\tint size;", "};", ""]
    lines.append("static const PromptSvg PROMPT_STANDARD[] = {")
    for key, index in standard:
        lines.append(f'\t{{ "{key}", PROMPT_SVG_{index}, (int)sizeof(PROMPT_SVG_{index}) }},')
    lines += ["};", ""]
    sheet = open(os.path.join(prompt_images.THIRDPARTY, "pixel", "tilemap_packed.png"), "rb").read()
    lines.append(f"static const unsigned char PROMPT_PIXEL_SHEET[] = {{{bytes_literal(sheet)}}};")
    lines.append(f"static const int PROMPT_PIXEL_COLUMNS = {prompt_images.PIXEL_COLUMNS};")
    lines.append(f"static const int PROMPT_PIXEL_TILE = {prompt_images.PIXEL_TILE};")
    lines += ["", "struct PromptTiles {", "\tconst char *control;", "\tint tiles[3];", "\tint count;", "};", ""]
    lines.append("static const PromptTiles PROMPT_PIXEL[] = {")
    for family, controls in prompt_images.PIXEL.items():
        for control, tiles in controls.items():
            padded = (tiles + [0, 0, 0])[:3]
            lines.append(f'\t{{ "{family}/{control}", {{ {", ".join(map(str, padded))} }}, {len(tiles)} }},')
    lines += ["};", ""]
    write_if_changed(os.path.join(here, "prompt_images.gen.h"), "\n".join(lines))


def generate_wheel_layouts():
    data = json.load(open(os.path.join(here, "data", "wheel_layouts.json"), encoding="utf-8"))
    text = json.dumps(data, separators=(",", ":"))
    write_if_changed(
        os.path.join(here, "wheel_layouts.gen.h"),
        "// Generated by modules/controls/SCsub from data/wheel_layouts.json: don't edit.\n#pragma once\n\n"
        f"static const char *WHEEL_LAYOUTS_JSON = {json.dumps(text)};\n",
    )


generate_prompt_images()
generate_wheel_layouts()
env_controls.add_source_files(env.modules_sources, "*.cpp")
