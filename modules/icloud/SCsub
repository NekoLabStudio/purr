#!/usr/bin/env python

Import("env")
Import("env_modules")

env_icloud = env_modules.Clone()
env_icloud.add_source_files(env.modules_sources, "*.mm")
env_icloud.add_source_files(env.modules_sources, "*.cpp")

# On iOS and tvOS the exported Xcode project links CloudKit (Purr's export plugin adds it).
if env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "CloudKit"])
