#!/usr/bin/env python

import os

Import("env")
Import("env_modules")

env_mcp = env_modules.Clone()

here = Dir(".").srcnode().abspath
modules_dir = os.path.dirname(here)
docs_dir = os.path.join(os.path.dirname(modules_dir), "docs")


def c_string(text):
    # A raw string literal, split so no piece passes MSVC's limit on string literals.
    pieces = [text[i : i + 8000] for i in range(0, len(text), 8000)] or [""]
    return " ".join('R"PURRDOC(' + piece + ')PURRDOC"' for piece in pieces)


def make_guides(target, source, env):
    # Purr's guides, as the docs site has them: path from docs/, and the Markdown.
    entries = []
    for node in sorted(source, key=lambda s: str(s)):
        path = os.path.relpath(str(node), docs_dir).replace(os.sep, "/")
        with open(str(node), encoding="utf-8") as f:
            entries.append("\t{ \"%s\", %s }," % (path, c_string(f.read())))
    with open(str(target[0]), "w", encoding="utf-8") as f:
        f.write("#pragma once\n\n// Generated by modules/mcp/SCsub from docs/.\n\n")
        f.write("struct McpGuide {\n\tconst char *path;\n\tconst char *text;\n};\n\n")
        f.write("inline constexpr McpGuide MCP_GUIDES[] = {\n" + "\n".join(entries) + "\n};\n")


def make_purr_classes(target, source, env):
    # The classes Purr's modules document, to tell them apart from Godot's.
    names = sorted({os.path.splitext(os.path.basename(str(s)))[0] for s in source})
    with open(str(target[0]), "w", encoding="utf-8") as f:
        f.write("#pragma once\n\n// Generated by modules/mcp/SCsub from Purr's modules' doc_classes.\n\n")
        f.write("inline constexpr const char *MCP_PURR_CLASSES[] = {\n")
        f.write("".join('\t"%s",\n' % n for n in names))
        f.write("};\n")


guides = []
for root, _, files in os.walk(docs_dir):
    guides += [os.path.join(root, name) for name in files if name.endswith(".md")]
purr_classes = []
for module in sorted(os.listdir(modules_dir)):
    folder = os.path.join(modules_dir, module, "doc_classes")
    if os.path.isdir(folder):
        purr_classes += [os.path.join(folder, name) for name in os.listdir(folder) if name.endswith(".xml")]

env_mcp.Command("mcp_guides.gen.h", guides, env.Run(make_guides))
env_mcp.Command("mcp_purr_classes.gen.h", purr_classes, env.Run(make_purr_classes))

env_mcp.add_source_files(env.modules_sources, "*.cpp")
env_mcp.add_source_files(env.modules_sources, "editor/*.cpp")
